# LAMMPS-Kokkos PPPM benchmark: all-atom water with SHAKE

clear
units           real
dimension       3
boundary        p p p
atom_style      full
newton          off

bond_style      harmonic
angle_style     harmonic
pair_style      lj/cut/coul/long 9.0 9.0
read_data       ${DATA_FILE}
replicate       ${RX} ${RY} ${RZ}

pair_modify     mix arithmetic
special_bonds   lj/coul 0.0 0.0 0.0
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
kspace_style    pppm 1.0e-4

velocity        all create 298.0 20260811 mom yes rot yes dist gaussian loop geom
timestep        0.5
fix             constraints all shake 1.0e-4 20 0 b 1 a 1
fix             integrator all nvt temp 298.0 298.0 5.0 tloop 1 tchain 3

thermo          2000
thermo_style    custom step atoms temp press pe ke etotal evdwl ecoul elong
thermo_modify   flush yes lost error
timer           full sync

variable        RUNSTEPS index 2000
run             ${RUNSTEPS}
