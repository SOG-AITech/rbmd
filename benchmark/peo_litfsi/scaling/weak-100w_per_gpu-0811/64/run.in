#  simulation

units       real
dimension	3
boundary	p p p
atom_style	     full 
timer full sync

neighbor	     2.0 bin
neigh_modify	 every  1 delay 0  one 2000 check yes

# LJ potentials

pair_style	    lj/cut/coul/long   12
kspace_style     pppm 1e-4
pair_modify   mix geometric

bond_style     harmonic 
angle_style    harmonic 
dihedral_style opls


#读取模型数据文件 
read_data /public/home/acymkxdx47/RBMD2/benchmark/data/peo_litfsi.data       




# output
thermo		 1000
thermo_style  custom step temp press  pe  ke etotal  evdwl ecoul elong   ebond  eangle  edihed vol



timestep	 0.5


fix    1    all nvt temp 343 343 5 


run 2000


